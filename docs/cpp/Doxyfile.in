# Doxyfile - C++ API Documentation for libstb

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "libstb C++"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Images, fonts and zlib on top of stb"
OUTPUT_DIRECTORY       = @LIBSTB_DOCS_CPP_OUT@
OUTPUT_LANGUAGE        = English

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT                  = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md \
                          @PROJECT_SOURCE_DIR@/include/stb.h \
                          @PROJECT_SOURCE_DIR@/include/stb
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.hxx
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/docs/cpp/mainpage.md
# INCLUDE_PATH lets Doxygen resolve <stb/...> includes for the include graph.
INCLUDE_PATH           = @PROJECT_SOURCE_DIR@/include
EXAMPLE_PATH           =
EXAMPLE_PATTERNS       = *.cpp
EXAMPLE_RECURSIVE      = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_STYLESHEET        = @AWESOME_HTML_STYLESHEET@
HTML_EXTRA_STYLESHEET  = @AWESOME_HTML_EXTRA_STYLESHEET@ @LIBSTB_DOXYGEN_CSS@
HTML_HEADER            = @OUTPUT_DIR@/header.html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_FOOTER            = @OUTPUT_DIR@/footer.html

GENERATE_LATEX         = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = png
DOT_CLEANUP            = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
PREDEFINED             =
SKIP_FUNCTION_MACROS   = YES
