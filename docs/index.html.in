<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>libstb: image I/O with no dependencies</title>
<meta name="description" content="libstb wraps Sean Barrett's stb libraries in a typed C++17 API and a Python module: decode, resize, edit and encode PNG, JPEG, BMP and TGA, and render TrueType text.">
<link rel="icon" href="@FAVICON@" type="image/svg+xml">
<script>
(function () {
  var t = 'light';
  try {
    var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}');
    if (s.theme) t = s.theme; else if (matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
  } catch (e) {}
  document.documentElement.setAttribute('data-theme', t);
})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;600&display=swap">
<link rel="stylesheet" href="assets/libstb-docs.css">
</head>
<body>

<header class="topbar">
  <a class="topbar-brand" href="index.html">
    <span class="topbar-logo">@LOGO_CONTENT@</span><span class="topbar-name">libstb</span>
    <span class="topbar-sep"></span><span class="topbar-sub">Documentation</span>
  </a>
  <nav class="topbar-nav" aria-label="Sections">
    <a class="topbar-link" href="python/html/index.html">Python</a>
    <a class="topbar-link" href="cpp/html/index.html">C++</a>
    <a class="topbar-link" href="benchmarks/index.html">Benchmarks</a>
  </nav>
  <div class="topbar-actions">
    <span class="topbar-version">v@PROJECT_VERSION@</span>
    <a class="topbar-gh" href="https://github.com/MohammadRaziei/libstb" target="_blank" rel="noopener">GitHub</a>
    <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>
    </button>
  </div>
</header>

<main>
<section class="hero">
  <div class="hero-grid">
    <div>
      <h1>Image I/O with <em>no dependencies.</em></h1>
      <p class="lede">libstb wraps Sean Barrett's <a href="https://github.com/nothings/stb">stb</a> libraries in a typed C++17 API and a Python module. Decode, resize, edit and encode PNG, JPEG, BMP and TGA, and render TrueType text, from one wheel.</p>
      <div class="hero-actions">
        <a class="btn" href="python/html/index.html">Python reference</a>
        <a class="btn ghost" href="cpp/html/index.html">C++ reference</a>
      </div>
      <div class="cmd"><span><span class="prompt">$</span> pip install libstb</span><button class="copy-btn" type="button" onclick="copyText(this, 'pip install libstb')">Copy</button></div>
    </div>

    <figure class="demo" id="demo" aria-labelledby="demo-title">
      <div class="demo-frame"><img id="demo-img" src="showcase/cubic-24.png" width="128" height="128" alt="A photograph of fruit resized to 24 by 24 pixels by libstb and shown enlarged"></div>
      <figcaption class="demo-cap" id="demo-title" aria-live="polite"></figcaption>
      <div class="demo-controls">
        <div class="demo-row"><span>Filter</span>
          <span class="seg" role="group" aria-label="Resize filter">
            <button type="button" data-filter="box" aria-pressed="false">box</button>
            <button type="button" data-filter="linear" aria-pressed="false">linear</button>
            <button type="button" data-filter="cubic" aria-pressed="true">cubic</button>
          </span>
        </div>
        <div class="demo-row"><label for="demo-size">Size</label>
          <input id="demo-size" type="range" min="0" max="8" step="1" value="3">
          <output id="demo-out" for="demo-size">24 &times; 24</output>
        </div>
      </div>
    </figure>
  </div>
</section>

<section class="section" id="why">
  <div class="wrap">
    <h2>What you get, and what backs it up</h2>
    <div class="claims">

      <div class="claim">
        <div>
          <h3>Nothing else to install.</h3>
          <p>No system libraries and no Python packages. The stb headers are private; the public API is <code>stb::image</code>, <code>stb::resizer</code> and <code>stb::font</code>.</p>
        </div>
        <div class="proof">
          <div class="big">0<small>dependencies</small></div>
          <div class="cap">numpy and Pillow are optional, and only imported when you ask for <code>img.numpy()</code> or <code>stb.imread()</code>.</div>
          <div id="proof-install"></div>
        </div>
      </div>

      <div class="claim">
        <div>
          <h3>Quick, with the losses shown.</h3>
          <p>The pixel kernels pick a SIMD backend at run time (AVX2, SSE2, NEON or scalar) and every backend gives identical output. The bars include the operations where Pillow or OpenCV is faster.</p>
        </div>
        <div class="proof" id="proof-speed">
          <div class="cap">Time per operation, averaged over every corpus entry, as a multiple of libstb (1.0&times; is libstb; larger is slower).</div>
          <p class="proof-note"><a href="benchmarks/index.html">Open the full benchmark report</a>.</p>
        </div>
      </div>

      <div class="claim">
        <div>
          <h3>Checked before it is timed.</h3>
          <p>Every operation and library is run on small non-square images and its output compared before a single speed number is recorded.</p>
        </div>
        <div class="proof" id="proof-verify">
          <div class="cap">Lossless formats must decode to the original pixels exactly; resize output is compared with Pillow's for the same filter.</div>
        </div>
      </div>

      <div class="claim">
        <div>
          <h3>Your arrays, not copies.</h3>
          <p>The Python <code>Image</code> is the C++ image itself, not a wrapper. It shares memory with numpy and with DLPack consumers such as torch.</p>
        </div>
        <div class="proof">
          <div class="code" style="margin:0"><div class="code-head"><span>python</span></div><pre><code><span class="tok-k">import</span> numpy <span class="tok-k">as</span> np
<span class="tok-k">import</span> libstb <span class="tok-k">as</span> stb

img = stb.Image.<span class="tok-f">open</span>(<span class="tok-s">"photo.png"</span>)
a = np.<span class="tok-f">asarray</span>(img)        <span class="tok-c"># no copy</span>
t = torch.<span class="tok-f">from_dlpack</span>(img)  <span class="tok-c"># no copy</span></code></pre></div>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="section" id="start">
  <div class="wrap">
    <h2>Install it, then use it</h2>
    <div class="two" style="margin-top:2rem">
      <div>
        <h3 style="font-size:1.2rem">Install</h3>
        <div class="tabs">
          <div class="tab-bar">
@INSTALL_TABS@          </div>
@INSTALL_CONTENT@        </div>
      </div>
      <div>
        <h3 style="font-size:1.2rem">Use</h3>
        <div class="tabs">
          <div class="tab-bar">
@EXAMPLE_TABS@          </div>
@EXAMPLE_CONTENT@        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="what">
  <div class="wrap">
    <h2>One library, three jobs</h2>
    <div class="claims">
      <div class="claim">
        <div><h3>Images.</h3></div>
        <div class="proof"><p style="margin:0;max-width:none">Decode and encode PNG, JPEG, BMP and TGA. Resize with selectable filters, and edit with <code>crop</code>, <code>flip</code>, <code>rotate90</code>, <code>pad</code>, <code>convert</code> and <code>composite</code>, with EXIF orientation applied on request. Every operation returns a new image.</p></div>
      </div>
      <div class="claim">
        <div><h3>Fonts.</h3></div>
        <div class="proof"><p style="margin:0;max-width:none">Render UTF-8 text from a TrueType font to a bitmap, or build a glyph atlas.</p></div>
      </div>
      <div class="claim">
        <div><h3>Run-time SIMD.</h3></div>
        <div class="proof"><p style="margin:0;max-width:none">One build runs on every x86-64 or ARM machine: the kernels choose AVX2, SSE2, NEON or a scalar fallback when the library loads.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="reference">
  <div class="wrap">
    <h2>API reference</h2>
    <div class="refs">
@DOCS_CONTENT@
    </div>
  </div>
</section>
</main>

<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="footer-brand">@LOGO_CONTENT@<span>libstb</span></div>
      <p>Image I/O, resizing and font rendering on top of the stb single-header libraries, with a binding for @BINDING_LIST@. MIT license. v@PROJECT_VERSION@</p>
      <p style="margin-top:.6rem">Demo photograph: fruits.jpg from OpenCV's sample data (Apache-2.0), resized by libstb.</p>
    </div>
    <div class="footer-links">
      <a href="python/html/index.html">Python reference</a>
      <a href="cpp/html/index.html">C++ reference</a>
      <a href="benchmarks/index.html">Benchmarks</a>
      <a href="https://github.com/MohammadRaziei/libstb">GitHub</a>
      <a href="https://pypi.org/project/libstb/">PyPI</a>
    </div>
  </div>
</footer>

<script src="assets/bench-teaser.js"></script>
<script>
function toggleTheme() {
  var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', t);
  try { var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}'); s.theme = t; localStorage.setItem('libstb-docs', JSON.stringify(s)); } catch (e) {}
}
function switchTab(panel, folder) {
  document.querySelectorAll('[data-tab^="' + panel + '-"]').forEach(function (b) { b.classList.toggle('active', b.dataset.tab === panel + '-' + folder); });
  document.querySelectorAll('[id^="' + panel + '-"].tab-content').forEach(function (c) { c.classList.toggle('active', c.id === panel + '-' + folder); });
}
function copyText(btn, text) {
  var done = function () { var o = btn.textContent; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = o; }, 1400); };
  if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, done); else done();
}
function copyCode(btn) { copyText(btn, btn.closest('.code').querySelector('code').innerText); }

/* The live piece. Every frame is a PNG that libstb itself wrote (docs/make_showcase.py). */
(function () {
  var SIZES = [8, 12, 16, 24, 32, 48, 64, 96, 128];
  var img = document.getElementById('demo-img'), cap = document.getElementById('demo-title');
  var range = document.getElementById('demo-size'), out = document.getElementById('demo-out');
  var filter = 'cubic';
  img.addEventListener('error', function () { document.getElementById('demo').hidden = true; });   // frames are made at build time
  function show() {
    var n = SIZES[+range.value];
    img.src = 'showcase/' + filter + '-' + n + '.png';
    img.alt = 'A photograph of fruit resized to ' + n + ' by ' + n + ' pixels with the ' + filter + ' filter, shown enlarged';
    out.textContent = n + ' \u00d7 ' + n;
    cap.innerHTML = '<code>img.resize(' + n + ', ' + n + ', "' + filter + '")</code> writes ' + (n * n).toLocaleString('en-US') +
      ' pixels. This is the file libstb wrote, shown enlarged.';
  }
  range.addEventListener('input', show);
  document.querySelectorAll('.seg button').forEach(function (b) {
    b.addEventListener('click', function () {
      filter = b.dataset.filter;
      document.querySelectorAll('.seg button').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
      show();
    });
  });
  show();
})();
</script>
</body>
</html>
