<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>libstb: images, fonts and zlib with no dependencies</title>
<meta name="description" content="libstb wraps Sean Barrett's stb libraries in a typed C++17 API and a Python module: decode, resize, edit and encode PNG, JPEG, BMP and TGA, render TrueType text, and compress zlib streams.">
<link rel="icon" href="@FAVICON@" type="image/svg+xml">
<script>
(function () {
  var t = 'light';
  try {
    var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}');
    if (s.theme) t = s.theme; else if (matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
  } catch (e) {}
  document.documentElement.setAttribute('data-theme', t);
  document.documentElement.classList.add('js');
})();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;600&display=swap"> <!-- taste-skill-ignore: JetBrains Mono is used for code only -->
<link rel="stylesheet" href="assets/libstb-docs.css">
</head>
<body>

<header class="topbar">
  <a class="topbar-brand" href="index.html">
    <span class="topbar-logo">@LOGO_CONTENT@</span><span class="topbar-name">libstb</span>
    <span class="topbar-sep"></span><span class="topbar-sub">Documentation</span>
  </a>
  <nav class="topbar-nav" aria-label="Sections">
    <a class="topbar-link" href="python/html/index.html">Python</a>
    <a class="topbar-link" href="cpp/html/index.html">C++</a>
    <a class="topbar-link" href="benchmarks/index.html">Benchmarks</a>
  </nav>
  <div class="topbar-actions">
    <span class="topbar-version">v@PROJECT_VERSION@</span>
    <a class="topbar-gh" href="https://github.com/MohammadRaziei/libstb" target="_blank" rel="noopener">GitHub</a>
    <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>
    </button>
  </div>
</header>

<main>
<section class="hero">
  <div class="hero-grid">
    <div class="hero-copy">
      <h1><span class="mask"><span>Images, fonts and zlib,</span></span> <span class="mask"><span>with no dependencies.</span></span></h1>
      <p class="lede">A C++17 library and a Python module on top of Sean Barrett's <a href="https://github.com/nothings/stb">stb</a>. Decode, resize, edit and encode PNG, JPEG, BMP and TGA, render TrueType text, and compress zlib streams.</p>
      <div class="hero-actions">
        <a class="btn" href="#start">Install libstb</a>
        <a class="hero-link" href="cpp/html/index.html">C++ reference</a>
        <a class="hero-link" href="python/html/index.html">Python reference</a>
      </div>
      <p class="hero-note">C++17 core, Python 3.9+ module. Pre-built wheels for Linux, macOS and Windows. MIT license.</p>
    </div>

    <figure class="demo" id="demo" aria-labelledby="demo-title">
      <div class="demo-frame"><img id="demo-img" src="showcase/cubic-24.png" width="128" height="128" alt="A photograph of fruit resized to 24 by 24 pixels by libstb and shown enlarged"></div>
      <figcaption class="demo-cap" id="demo-title" aria-live="polite"></figcaption>
      <div class="demo-controls">
        <div class="demo-row"><span>Filter</span>
          <span class="seg" role="group" aria-label="Resize filter">
            <button type="button" data-filter="box" aria-pressed="false">box</button>
            <button type="button" data-filter="linear" aria-pressed="false">linear</button>
            <button type="button" data-filter="cubic" aria-pressed="true">cubic</button>
          </span>
        </div>
        <div class="demo-row"><label for="demo-size">Size</label>
          <input id="demo-size" type="range" min="0" max="8" step="1" value="3">
          <output id="demo-out" for="demo-size">24 &times; 24</output>
        </div>
      </div>
    </figure>
  </div>
</section>

<section class="section" id="start">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Install and use</h2>
      <div class="tab-bar" role="tablist" aria-label="Language">
@LANG_TABS@      </div>
    </div>
@START_CONTENT@  </div>
</section>

<section class="section" id="what">
  <div class="wrap">
    <h2 class="reveal">One library, three jobs</h2>
    <div class="jobs">

      <article class="job job-images reveal">
        <div>
          <h3>Images</h3>
          <p>Decode and encode PNG, JPEG, BMP and TGA. Resize with selectable filters, and edit with <code>crop</code>, <code>flip</code>, <code>rotate90</code>, <code>pad</code>, <code>convert</code> and <code>composite</code>, with EXIF orientation applied on request. Every operation returns a new image.</p>
        </div>
        <ul class="tour" id="tour" aria-label="One photograph and four edits of it, each written by libstb">
          <li style="--s:1"><img src="showcase/tour-open.png" width="160" height="160" alt="The photograph at 160 by 160 pixels"><span><code>open</code></span></li>
          <li style="--s:.6"><img src="showcase/tour-crop.png" width="96" height="96" alt="The middle of the photograph, cropped to 96 by 96 pixels"><span><code>crop</code></span></li>
          <li style="--s:1"><img src="showcase/tour-rotate.png" width="160" height="160" alt="The photograph turned a quarter turn counter-clockwise"><span><code>rotate90</code></span></li>
          <li style="--s:1"><img src="showcase/tour-gray.png" width="160" height="160" alt="The photograph converted to one grey channel"><span><code>convert(1)</code></span></li>
          <li style="--s:1"><img src="showcase/tour-flip.png" width="160" height="160" alt="The photograph mirrored left to right"><span><code>flip_horizontal</code></span></li>
        </ul>
      </article>

      <article class="job job-fonts reveal">
        <h3>Fonts</h3>
        <p>Render UTF-8 text from a TrueType font to a bitmap, or build a glyph atlas. To lay text out before you have a font file, estimate its size from built-in metrics.</p>
<pre data-lang="python" data-label="python">font = stb.Font.open("font.ttf")
font.render("Hello", 32).bitmap.write("hello.png")

# the size of a text, with no font file
size = stb.estimate_text("Hello", 32)
print(size.width, size.height)</pre>
      </article>

      <article class="job job-zlib reveal">
        <h3>zlib</h3>
        <p>Compress and decompress zlib streams. Decompression takes an output limit, so a decompression bomb ends in an error and not in an exhausted machine.</p>
<pre data-lang="python" data-label="python">packed = stb.zlib_compress(data, 6)

# raises LimitError past max_bytes
data = stb.zlib_decompress(
    packed, max_bytes=64 &lt;&lt; 20)</pre>
      </article>

    </div>
  </div>
</section>

<section class="section" id="why">
  <div class="wrap">
    <h2 class="reveal">What backs it up</h2>
    <div class="proofs">

      <article class="tile tile-speed reveal">
        <h3>Quick, with the losses shown.</h3>
        <p>The pixel kernels pick a SIMD backend at run time (AVX2, SSE2, NEON or scalar) and every backend gives identical output. The bars include the operations where Pillow or OpenCV is faster, and what each library weighs when you install it.</p>
        <div class="proof" id="proof-speed">
          <div class="cap">Time per operation, averaged over every corpus entry, as a multiple of libstb (1.0&times; is libstb; larger is slower).</div>
          <div id="proof-install"></div>
          <p class="proof-note"><a href="benchmarks/index.html">Open the full benchmark report</a>.</p>
        </div>
      </article>

      <div class="proof-col">

      <article class="tile tile-deps reveal">
        <h3>Nothing else to install.</h3>
        <p>No system libraries and no Python packages. The stb headers are private; the public API is <code>stb::image</code>, <code>stb::resizer</code>, <code>stb::font</code> and <code>stb::zlib_compress</code>.</p>
        <div class="proof">
          <div class="big">0<small>dependencies</small></div>
        </div>
      </article>

      <article class="tile tile-verify reveal">
        <h3>Checked before it is timed.</h3>
        <p>Every operation and library is run on small non-square images and its output compared before a single speed number is recorded.</p>
        <div class="proof" id="proof-verify">
          <div class="cap">Lossless formats must decode to the original pixels exactly; resize output is compared with Pillow's for the same filter.</div>
        </div>
      </article>

      <article class="tile tile-copy reveal">
        <h3>Your arrays, not copies.</h3>
        <p>The Python <code>Image</code> is the C++ image itself, not a wrapper. numpy and DLPack consumers such as torch get a view of the same memory, and Pillow converts with <code>to_pil()</code> and <code>from_pil()</code>.</p>
<pre data-lang="python" data-label="python">import numpy as np
import libstb as stb

img = stb.Image.open("photo.png")
a = np.asarray(img)          # no copy
t = torch.from_dlpack(img)   # no copy
pil = img.to_pil()           # one copy</pre>
      </article>

      </div>

    </div>
  </div>
</section>

<section class="section" id="reference">
  <div class="wrap">
    <h2 class="reveal">API reference</h2>
    <div class="refs">
@DOCS_CONTENT@    </div>
  </div>
</section>
</main>

<footer class="footer">
  <div class="footer-inner">
    <div>
      <div class="footer-brand">@LOGO_CONTENT@<span>libstb</span></div>
      <p>Images, fonts and zlib on top of the stb single-header libraries, with a binding for @BINDING_LIST@. MIT license. v@PROJECT_VERSION@</p>
      <p style="margin-top:.6rem">Demo photograph: fruits.jpg from OpenCV's sample data (Apache-2.0), resized by libstb.</p>
    </div>
    <div class="footer-links">
      <a href="python/html/index.html">Python reference</a>
      <a href="cpp/html/index.html">C++ reference</a>
      <a href="benchmarks/index.html">Benchmarks</a>
      <a href="https://github.com/MohammadRaziei/libstb">GitHub</a>
      <a href="https://pypi.org/project/libstb/">PyPI</a>
    </div>
  </div>
</footer>

<script src="assets/bench-teaser.js"></script>
<script>
function toggleTheme() {
  var t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', t);
  try { var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}'); s.theme = t; localStorage.setItem('libstb-docs', JSON.stringify(s)); } catch (e) {}
}
function switchTab(folder) {
  document.querySelectorAll('.tab-btn').forEach(function (b) {
    var on = b.dataset.tab === folder;
    b.classList.toggle('active', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
  });
  document.querySelectorAll('.tab-content').forEach(function (c) { c.classList.toggle('active', c.id === 'start-' + folder); });
  try { var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}'); s.lang = folder; localStorage.setItem('libstb-docs', JSON.stringify(s)); } catch (e) {}
}
function copyText(btn, text) {
  var done = function () { var o = btn.textContent; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = o; }, 1400); };
  if (navigator.clipboard) navigator.clipboard.writeText(text).then(done, done); else done();
}
function copyCode(btn) { copyText(btn, btn.closest('.code').querySelector('code').innerText); }

/* The live piece. Every frame is a PNG that libstb itself wrote (docs/make_showcase.py). */
(function () {
  var SIZES = [8, 12, 16, 24, 32, 48, 64, 96, 128];
  var img = document.getElementById('demo-img'), cap = document.getElementById('demo-title');
  var range = document.getElementById('demo-size'), out = document.getElementById('demo-out');
  var filter = 'cubic';
  img.addEventListener('error', function () { document.getElementById('demo').hidden = true; });   // frames are made at build time
  function show() {
    var n = SIZES[+range.value];
    img.src = 'showcase/' + filter + '-' + n + '.png';
    img.alt = 'A photograph of fruit resized to ' + n + ' by ' + n + ' pixels with the ' + filter + ' filter, shown enlarged';
    out.textContent = n + ' \u00d7 ' + n;
    cap.innerHTML = '<code>img.resize(' + n + ', ' + n + ', "' + filter + '")</code> writes ' + (n * n).toLocaleString('en-US') +
      ' pixels. This is the file libstb wrote, shown enlarged.';
  }
  range.addEventListener('input', show);
  document.querySelectorAll('.seg button').forEach(function (b) {
    b.addEventListener('click', function () {
      filter = b.dataset.filter;
      document.querySelectorAll('.seg button').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
      show();
    });
  });
  show();
})();

/* The language chosen last time, the headline's entrance, and the entrance of each block as it scrolls in. */
(function () {
  try { var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}'); if (s.lang && document.querySelector('.tab-btn[data-tab="' + s.lang + '"]')) switchTab(s.lang); } catch (e) {}
  requestAnimationFrame(function () { requestAnimationFrame(function () { document.documentElement.classList.add('ready'); }); });
  var blocks = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) { blocks.forEach(function (b) { b.classList.add('in'); }); return; }
  var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .12 });
  blocks.forEach(function (b) { io.observe(b); });
  document.querySelectorAll('.tour img').forEach(function (i) { i.addEventListener('error', function () { document.getElementById('tour').hidden = true; }); });   // frames are made at build time
})();
</script>
</body>
</html>
