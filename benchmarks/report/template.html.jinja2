<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>libstb Benchmarks</title>
<script>
(function () {
  var t = 'light';
  try {
    var s = JSON.parse(localStorage.getItem('libstb-docs') || '{}');
    if (s.theme) t = s.theme; else if (matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
  } catch (e) {}
  document.documentElement.setAttribute('data-theme', t);
})();
</script>
{% if favicon %}<link rel="icon" href="{{ favicon }}" type="image/svg+xml">
{% endif %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;600&display=swap">
<link rel="stylesheet" href="{{ katex_base }}katex.min.css">
<style>
{{ site_css | safe }}
.topbar a { text-decoration: none; }
.katex { font-size: 1.04em; }
:root {
  --r: 4px;
  --bg-panel: var(--card);
  --bg-panel-2: var(--bg3);
  --text: var(--fg);
  --text-dim: var(--fg3);
  --mono: var(--font-mono);
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); line-height: 1.55; }
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px 80px; }

/* ---- Hero: the landing page's field, left aligned ---- */
/* the brand field in both themes (the landing page's dark theme uses a dark hero; here the green is the page's head) */
.hero { --hero-bg: var(--brand); --hero-fg: var(--on-brand); --hero-fg2: #2b2810; background: var(--hero-bg); color: var(--hero-fg); }
.hero-inner { max-width: 1080px; margin: 0 auto; padding: 4.5rem 24px 4rem; }
.hero .eyebrow { font-size: .9rem; color: var(--hero-fg2); margin-bottom: 1rem; }
.hero h1 { font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.04; margin: 0 0 1.2rem; max-width: 22ch; font-weight: 800; font-stretch: 112%; letter-spacing: -.035em; }
.hero p.sub { color: var(--hero-fg); font-size: 1.125rem; max-width: 40rem; margin: 0; }
.hero .meta { margin-top: 1.6rem; font-size: .9rem; color: var(--hero-fg2); }

/* ---- Sections: no rules, tone and space do the separating ---- */
section { padding: 0; }
section.major { padding-top: 6rem; }
.kicker { font-size: .95rem; color: var(--text-dim); font-weight: 600; margin-bottom: .5rem; }
h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); font-stretch: 112%; margin: 0 0 .9rem; letter-spacing: -.03em; line-height: 1.1; }
h3.op-title { font-size: 1.3rem; font-stretch: 108%; letter-spacing: -.02em; margin: 0 0 .4rem; }
.lede { color: var(--fg2); font-size: 1.0625rem; max-width: 44rem; margin: 0 0 2rem; }
.lede strong { color: var(--text); font-weight: 650; }
.lede a, .method a { color: var(--accent); }
.method { color: var(--fg2); font-size: 1rem; max-width: 46rem; padding-left: 1.25rem; }
.method li { margin: .7rem 0; }
.method strong { color: var(--text); font-weight: 650; }
.op-note { color: var(--text-dim); font-size: .9rem; max-width: 46rem; margin: 0 0 .8rem; }
.op-winner { font-size: 1rem; margin: 0 0 1.2rem; color: var(--text); max-width: 46rem; }
.op-winner strong { color: var(--text); font-weight: 750; }
.subsection { margin-top: 3.5rem; }
.subsection:first-of-type { margin-top: 2rem; }

.mini-details { margin-bottom: 8px; }
.mini-details summary { cursor: pointer; user-select: none; font-size: .9rem; font-weight: 700; color: var(--text); padding: .6rem 0; list-style: none; }
.mini-details summary::-webkit-details-marker { display: none; }
.mini-details summary::before { content: '\25B8'; display: inline-block; margin-right: 6px; transition: transform 150ms ease; }
.mini-details[open] summary::before { transform: rotate(90deg); }
.mini-details summary:hover { color: var(--text-dim); }

/* ---- Panels: a tone step off the ground, the charts sit on them ---- */
.panel { background: var(--bg-panel); border-radius: var(--r); padding: 26px; margin-bottom: 12px; }
.panel h4 { margin: 0 0 .6rem; font-size: .95rem; color: var(--text); font-weight: 700; }
.chart-box { position: relative; height: 320px; }
.dir { font-weight: 400; color: var(--text-dim); font-size: .85em; }
.chart-box.tall { height: 420px; }
.chart-pair { display: grid; grid-template-columns: 1fr; gap: 12px; }
.chart-pair .panel { margin-bottom: 0; }

/* ---- Tables (rules between rows are the one place they stay) ---- */
table { width: 100%; border-collapse: collapse; font-size: .9rem; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); }
th { color: var(--text-dim); font-weight: 600; font-size: .85rem; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
tr:last-child td { border-bottom: none; }

.dl-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.4rem; }
.dl-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--bg-panel-2); border: 0; color: var(--text); padding: 9px 14px; border-radius: var(--r); font-size: .85rem; font-family: var(--mono); cursor: pointer; transition: background-color .15s ease; }
.dl-btn:hover { background: var(--border); }
.dl-btn svg { width: 14px; height: 14px; flex: none; }

footer { padding: 5rem 0 2.5rem; color: var(--text-dim); font-size: .85rem; text-align: center; }
footer a { color: var(--accent); }
footer a:hover { text-decoration: underline; }

.env-table { max-width: 480px; margin: 0 auto; }
.env-table td:first-child { color: var(--text-dim); width: 40%; }
.env-table td:last-child { color: var(--text); text-align: right; }
code { font-family: var(--mono); background: var(--bg-panel-2); padding: 1px 6px; border-radius: 3px; font-size: .92em; }

.size-table { margin-top: 1.4rem; }
.size-table tr.self-row td { color: var(--text); font-weight: 650; }
.size-table tr.self-row { background: var(--bg-panel-2); }
.size-table td.cap { color: var(--text-dim); font-size: .85rem; font-weight: 400; }
.size-rows { width: auto; margin: 0 0 1.2rem; font-size: .9rem; }
.size-rows th, .size-rows td { padding: 6px 16px 6px 0; }
.verify-note { font-size: .9rem; color: var(--fg2); margin-top: 1.2rem; max-width: 46rem; }

@media (max-width: 760px) { .topbar-sub, .topbar-sep, .topbar-gh, .topbar-version { display: none; } .topbar { padding: 0 1rem; gap: .5rem; } .topbar-nav { margin-left: 0; } .topbar-link { padding: .35rem .45rem; font-size: .85rem; } .panel { padding: 16px; } }
@media (max-width: 480px) { .topbar-name { display: none; } }
</style>
</head>
<body>

<header class="topbar">
  <a class="topbar-brand" href="../index.html">
    <span class="topbar-logo">{{ logo_svg | safe }}</span><span class="topbar-name">libstb</span>
    <span class="topbar-sep"></span><span class="topbar-sub">Documentation</span>
  </a>
  <nav class="topbar-nav" aria-label="Sections">
    <a class="topbar-link" href="../python/html/index.html">Python</a>
    <a class="topbar-link" href="../cpp/html/index.html">C++</a>
    <a class="topbar-link current" href="index.html" aria-current="page">Benchmarks</a>
  </nav>
  <div class="topbar-actions">
    <a class="topbar-gh" href="https://github.com/MohammadRaziei/libstb" target="_blank" rel="noopener">GitHub</a>
    <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>
    </button>
  </div>
</header>

<div class="hero"><div class="hero-inner">
  <div class="eyebrow">libstb benchmark report &middot; generated {{ generated_at }}</div>
  <h1>{{ headline | safe }}</h1>
  <p class="sub">{{ subhead | safe }}</p>
  <div class="meta">{{ meta_line }}</div>
</div></div>

<div class="wrap">

{% macro download(names) %}
<div class="dl-row">
  {% for name in names %}
  <button class="dl-btn" onclick="downloadJSON('{{ name }}')">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 11 5 5 5-5"/><path d="M5 21h14"/></svg>
    download {{ name }}.json
  </button>
  {% endfor %}
</div>
{% endmacro %}

{% macro op_body(op) %}
  {% if op.winner_summary %}<p class="op-winner">{{ op.winner_summary | safe }}</p>{% endif %}
  {% if op.memory_summary %}<p class="op-winner">{{ op.memory_summary | safe }}</p>{% endif %}

  {% if op.size_rows %}
  <table class="size-rows">
    <thead><tr><th>Output size</th><th class="num">\(\mathbb{E}\!\left[\dfrac{s_{L}}{s_{\text{ {{ op.size_rows[0].ref }} }}}\right]\)</th><th class="num">entries</th></tr></thead>
    <tbody>
    {% for row in op.size_rows %}
      <tr><td>{{ row.lib }}</td><td class="num">{{ row.ratio }}</td><td class="num">{{ row.n }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if op.has_tp %}
  <div class="panel">
    <h4>Throughput vs. image size <span class="dir">(higher is better)</span></h4>
    <div class="chart-box"><canvas id="chart-tp-{{ op.key }}"></canvas></div>
  </div>
  {% endif %}

  {% if op.has_time or op.has_mem %}
  <div class="chart-pair">
    {% if op.has_time %}
    <div class="panel">
      <h4>Time vs. image size <span class="dir">(lower is better)</span></h4>
      <div class="chart-box"><canvas id="chart-time-trend-{{ op.key }}"></canvas></div>
    </div>
    {% endif %}
    {% if op.has_mem %}
    <div class="panel">
      <h4>Extra peak memory vs. image size <span class="dir">(lower is better)</span></h4>
      <div class="chart-box"><canvas id="chart-mem-trend-{{ op.key }}"></canvas></div>
    </div>
    {% endif %}
  </div>
  {% endif %}
{% endmacro %}

<section class="major" id="method">
  <div class="kicker">Method</div>
  <h2>How the numbers are computed</h2>
  <p class="lede">Each corpus entry \(i\) is one image (a genre, a size and a format). For a library \(L\),
    \(t_i^{L}\) is the best of {{ repeats }} timed runs of one operation on entry \(i\), \(s_i^{L}\) is the size
    in bytes of the file it wrote, and \(m_i^{L}\) is its extra peak memory. Two libraries are compared only on
    the entries where both ran.</p>
  <ul class="method">
    <li><strong>Reference library.</strong> \(W_L=\bigl|\{\,i : t_i^{L}=\min_K t_i^{K}\,\}\bigr|\) is the number of
      entries on which \(L\) was fastest, and \(\mathrm{ref}=\arg\max_L W_L\) is the library that won the most.
      The count shows up in the per-operation summaries.</li>
    <li><strong>Headline ratio.</strong> Over the \(N\) entries both libraries ran,
      \(\mathbb{E}\!\left[\dfrac{t_L}{t_{\mathrm{ref}}}\right]=\dfrac{1}{N}\sum_{i=1}^{N}\dfrac{t_i^{L}}{t_i^{\mathrm{ref}}}\).
      It is the mean of each entry's own ratio (ratio first, then average), so a 64x64 image counts as much as a
      4000x4000 one. Above 1 means \(L\) took longer than the reference. Output size and extra memory use the same
      formula with \(s\) and \(m\) in place of \(t\).</li>
    <li><strong>Trend charts.</strong> For an image of \(z\) pixels, let \(G_z\) be the synthetic entries of that size
      (photo, gradient, noise, graphics). Each library's point is
      \(\bar t_L(z)=\Bigl(\prod_{i\in G_z} t_i^{L}\Bigr)^{1/|G_z|}\) for time, throughput
      \(\dfrac{z/10^{6}}{\bar t_L(z)}\) in MP/s, and \(\bar m_L(z)=\dfrac{1}{|G_z|}\sum_{i\in G_z} m_i^{L}\)
      for memory. Real photographs each have an odd size of their own, so they are left out of these charts (they still count in every ratio above).</li>
    <li><strong>Reading a ratio.</strong> Averaging ratios is not symmetric: a library 10 times faster on one entry
      and 10 times slower on another scores \(\mathbb{E}=(0.1+10)/2=5.05\), not 1. Read it together with the win
      count \(W_L\).</li>
  </ul>
</section>

{% if has_sizes %}
<section class="major" id="install-size">
  <div class="kicker">Install footprint</div>
  <h2>What <code>pip install</code> pulls in</h2>
  <p class="lede">Download size of the wheel for this platform plus every dependency, resolved from PyPI by
    <a href="https://github.com/MohammadRaziei/pip-size">pip-size</a>.
    Capability is not the same thing as size: a bigger package is usually doing far more, which is why the
    last column is here.</p>
  <div class="panel">
    <h4>Total download size <span class="dir">(lower is better)</span></h4>
    <div class="chart-box"><canvas id="chart-install-size"></canvas></div>
  </div>
  <table class="size-table">
    <thead><tr><th>Package</th><th class="num">Version</th><th class="num">Total</th><th class="num">Deps</th><th>What it is</th></tr></thead>
    <tbody>
    {% for row in size_rows %}
      <tr{% if row.is_self %} class="self-row"{% endif %}>
        <td>{{ row.label }}{% if row.is_self %} &#9733;{% endif %}</td>
        <td class="num">{{ row.version }}</td>
        <td class="num">{{ row.total }}</td>
        <td class="num">{{ row.n_deps }}</td>
        <td class="cap">{{ row.capability }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {{ download(['sizes']) }}
</section>
{% endif %}

{% for sec in sections %}
<section class="major" id="{{ sec.id }}">
  <div class="kicker">{{ sec.kicker }}</div>
  <h2>{{ sec.title }}</h2>
  <p class="lede">{{ sec.lede }} Speed is the best of {{ repeats }} runs;
    memory{% if has_throughput_memory %} is the extra peak RSS of one isolated process per measurement{% else %} was not measured{% endif %}.</p>
  {% for op in sec.ops_built %}
  <div class="subsection">
    <h3 class="op-title">{{ op.title }}</h3>
    <p class="op-note">{{ op.note | safe }}</p>
    {{ op_body(op) }}
  </div>
  {% endfor %}
  {{ download(['throughput', 'throughput_memory']) }}
</section>
{% endfor %}

{% if has_scaling %}
<section class="major" id="scaling">
  <div class="kicker">Scaling</div>
  <h2>Does the slope change with image size?</h2>
  <p class="lede">One photo-like image at each side length from {{ scaling.sides[0] }} to {{ scaling.sides[-1] }}
    pixels, one representative operation of each kind, libstb against Pillow and OpenCV. A flat line means the
    cost per pixel stays constant; a falling line means it grows with the image.</p>
  {% for panel in scaling.panels %}
  <div class="panel">
    <h4>{{ panel.title }} <span class="dir">(throughput, higher is better)</span></h4>
    <div class="chart-box"><canvas id="{{ panel.id }}"></canvas></div>
  </div>
  {% endfor %}
  {{ download(['scaling']) }}
</section>
{% endif %}

{% if has_fonts %}
<section class="major" id="fonts">
  <div class="kicker">Text</div>
  <h2>stb_truetype vs. FreeType</h2>
  <p class="lede">{{ fonts.font }}, libstb's <code>Font</code> against Pillow's FreeType binding on its basic
    layout engine (so Pillow is not charged for shaping, which stb_truetype does not do). The two rasterize
    differently, so this compares speed only. stb_truetype has no security guarantee on untrusted fonts;
    FreeType is hardened. No speed number captures that.</p>
  {% for op in fonts.ops %}
  <div class="subsection">
    <h3 class="op-title">{{ op.title }}</h3>
    {% if op.summary %}<p class="op-winner">{{ op.summary | safe }}</p>{% endif %}
    <div class="panel">
      <h4>Time per call <span class="dir">(lower is better)</span></h4>
      <div class="chart-box"><canvas id="{{ op.id }}"></canvas></div>
    </div>
    <details class="mini-details">
      <summary>See the numbers</summary>
      <table>
        <thead><tr><th>Case</th><th class="num">libstb</th><th class="num">Pillow</th><th class="num">libstb / Pillow</th></tr></thead>
        <tbody>
        {% for row in op.rows %}
          <tr><td>{{ row.label }}</td><td class="num">{{ row.libstb }}</td><td class="num">{{ row.pillow }}</td><td class="num">{{ row.ratio }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </details>
  </div>
  {% endfor %}
  {{ download(['fonts']) }}
</section>
{% endif %}

{% if verify or system_info %}
<section class="major" id="environment">
  <div class="kicker">Environment</div>
  <h2>Where these numbers came from</h2>
  {% if verify %}
  <p class="verify-note">Before anything was timed, every operation and library was run on small non-square images
    and its output checked (exact pixels for lossless formats, close for JPEG and resizing):
    {{ verify.passed }} checks passed, {{ verify.failed }} failed, {{ verify.unavailable }} library/operation
    pairs unavailable (formats a library cannot handle at all).</p>
  {% endif %}
  {% if system_info %}
  <div class="panel">
    <table class="env-table">
      <tr><td>CPU</td><td>{{ system_info.cpu_model }}</td></tr>
      <tr><td>Logical cores</td><td>{{ system_info.logical_cores }}</td></tr>
      {% if system_info.ram_gib %}<tr><td>RAM</td><td>{{ system_info.ram_gib }} GiB</td></tr>{% endif %}
      <tr><td>Architecture</td><td>{{ system_info.architecture }}</td></tr>
      <tr><td>OS</td><td>{{ system_info.os }}</td></tr>
      <tr><td>Python</td><td>{{ system_info.python_implementation }} {{ system_info.python_version }}</td></tr>
    </table>
  </div>
  {{ download(['system_info', 'verify']) }}
  {% endif %}
</section>
{% endif %}

</div>

<footer>
  For how the corpus was built, why timing uses best-of-N, and the memory-measurement
  gotcha this suite works around, see
  <a href="https://github.com/MohammadRaziei/libstb/blob/main/benchmarks/README.md">benchmarks/README.md</a>.
  <br>
  Generated by <code>benchmarks/report/generate_report.py</code> &middot;
  <a href="https://github.com/MohammadRaziei/libstb">github.com/MohammadRaziei/libstb</a>
</footer>

<script src="{{ chartjs_url }}"></script>
<script src="{{ katex_base }}katex.min.js"></script>
<script src="{{ katex_base }}contrib/auto-render.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  if (typeof renderMathInElement !== "function") return;
  renderMathInElement(document.body, {
    delimiters: [{left: "\\(", right: "\\)", display: false}],
    throwOnError: false,
    ignoredTags: ["script", "style", "textarea", "pre", "code", "option"],
  });
});
</script>

<script id="libstb-data" type="application/json">
{{ embedded_json | safe }}
</script>

<script>
const DATA = JSON.parse(document.getElementById('libstb-data').textContent);

// Two runtimes can load this exact HTML file: a published page
// (window.claude.use('downloads') handles saves, and a plain anchor+Blob
// click is inert there) or a plain browser tab, opened straight from
// disk, where window.claude.use does not exist and the classic
// anchor+Blob trick is what actually works. Feature-detect once.
let _downloadsApi = undefined; // undefined = not checked yet, null = checked, unavailable
(async () => {
  if (window.claude && typeof window.claude.use === 'function') {
    try { _downloadsApi = await window.claude.use('downloads'); }
    catch (e) { _downloadsApi = null; }
  } else {
    _downloadsApi = null;
  }
})();

async function downloadJSON(name) {
  const text = JSON.stringify(DATA[name], null, 2);
  const filename = name + '.json';
  if (_downloadsApi) {
    try {
      await _downloadsApi.save({ filename, data: new Blob([text], { type: 'application/json' }) });
    } catch (e) { /* viewer declined, or a transient error: no-op */ }
    return;
  }
  const blob = new Blob([text], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// The charts are built by mkChart() calls (one per canvas, in page order) and drawn by paint(), which takes the
// text, grid and series colours from the page theme. Switching theme redraws them; nothing else about them changes.
const RECOLOR = {{ recolor | tojson }};   // series colour on the dark theme -> on the light theme
const CHARTS = [];
function mkChart(id, config) { CHARTS.push({ id, config }); }
function recolor(v) {
  if (typeof v === 'string') { const k = v.slice(0, 7).toLowerCase(); return RECOLOR[k] ? RECOLOR[k] + v.slice(7) : v; }
  if (Array.isArray(v)) return v.map(recolor);
  if (v && typeof v === 'object') { const o = {}; for (const key in v) o[key] = recolor(v[key]); return o; }
  return v;
}
function paint() {
  const css = getComputedStyle(document.documentElement);
  const light = document.documentElement.getAttribute('data-theme') !== 'dark';
  Chart.defaults.color = css.getPropertyValue('--fg3').trim();
  Chart.defaults.borderColor = css.getPropertyValue('--border').trim();
  Chart.defaults.font.family = css.getPropertyValue('--font').trim();
  CHARTS.forEach(function (c) {
    if (c.chart) c.chart.destroy();
    c.chart = new Chart(document.getElementById(c.id), light ? recolor(c.config) : c.config);
  });
}
function toggleTheme() {
  const t = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', t);
  try { const s = JSON.parse(localStorage.getItem('libstb-docs') || '{}'); s.theme = t; localStorage.setItem('libstb-docs', JSON.stringify(s)); } catch (e) {}
  paint();
}

{{ chart_scripts | safe }}
paint();
</script>
</body>
</html>
