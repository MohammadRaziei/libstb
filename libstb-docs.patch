+/* The "API at a glance" table: the language tabs of the code boxes, hairlines only, a quiet label column. */
+.wrap {
+  margin-bottom: var(--ifm-leading);
+  overflow-x: auto;
+  border: 1px solid var(--ifm-color-emphasis-300);
+  border-radius: 6px;
+}
+
+.table {
+  display: table;
+  width: 100%;
+  margin: 0;
+  border-collapse: collapse;
+  background: transparent;
+}
+
+.table th,
+.table td {
+  padding: 0.65rem 1rem;
+  border: 0;
+  border-top: 1px solid var(--ifm-color-emphasis-200);
+  background: transparent;
+  text-align: left;
+  vertical-align: top;
+}
+
+.tabs {
+  display: flex;
+  padding: 0 0.35rem;
+  border-bottom: 1px solid var(--ifm-color-emphasis-300);
+  font-family: var(--ifm-font-family-monospace);
+  font-size: 0.82rem;
+}
+
+.tab {
+  min-height: 36px;
+  padding: 0 0.8rem;
+  margin-bottom: -1px;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  background: transparent;
+  color: var(--ifm-color-emphasis-600);
+  font: inherit;
+  cursor: pointer;
+}
