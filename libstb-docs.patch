+/* libstb docs identity: the Coolvetica wordmark (static/img/logo*.svg), flat grounds, one blue, ink for the active state, 4px radius.
+   Brand blue is used as text only where it passes 4.5:1 on its ground (see the dark block). */
+:root {
+  --libstb-ink: #14171c;
+  --libstb-on-ink: #f4f6f8;
+  --ifm-color-primary: #0a6c8f;
+  --ifm-color-primary-dark: #096281;
+  --ifm-color-primary-darker: #095d7a;
+  --ifm-color-primary-darkest: #074c64;
+  --ifm-color-primary-light: #0b7a9f;
+  --ifm-color-primary-lighter: #0c80a6;
+  --ifm-color-primary-lightest: #0e95c3;
+  --ifm-background-color: #f7f8fa;
+  --ifm-global-radius: 4px;
+  --ifm-font-family-base: 'Public Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
+  --ifm-font-family-monospace: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --ifm-code-font-size: 92%;
+  --docusaurus-highlighted-code-line-bg: rgba(10, 108, 143, 0.12);
+}
+
+[data-theme='dark'] {
+  --libstb-ink: #5cc3e8;
+  --libstb-on-ink: #0d1014;
+  --ifm-color-primary: #5cc3e8;
+  --ifm-color-primary-dark: #3fb8e3;
+  --ifm-color-primary-darker: #31b2e1;
+  --ifm-color-primary-darkest: #1a98c6;
+  --ifm-color-primary-light: #79cdeb;
+  --ifm-color-primary-lighter: #87d2ed;
+  --ifm-color-primary-lightest: #b0e1f3;
+  --ifm-background-color: #0d1014;
+  --docusaurus-highlighted-code-line-bg: rgba(92, 195, 232, 0.16);
+}
+
+.navbar {
+  box-shadow: none;
+  border-bottom: 1px solid var(--ifm-color-emphasis-300);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * {
+    animation-duration: 0.001ms !important;
+    transition-duration: 0.001ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* Reading pages: tighter headings, a left bar instead of a filled pill for the current page. */
+.markdown h1, .markdown h2, .markdown h3 { letter-spacing: -0.02em; }
+.markdown h1 { font-weight: 800; letter-spacing: -0.03em; }
+.menu__link--active:not(.menu__link--sublist) {
+  background: transparent; box-shadow: inset 2px 0 0 var(--ifm-color-primary); border-radius: 0;
+  color: var(--ifm-color-primary); font-weight: 600;
+}
+.navbar__link { font-weight: 500; }
+.navbar__link--active { color: var(--ifm-color-primary); }
+
+/* Code blocks match the ink window on the landing page. */
+.theme-code-block { --prism-background-color: #0d1014; --prism-color: #d7dde4; border: 1px solid #232a33; box-shadow: none; }
+.theme-code-block [class*='codeBlockTitle'] { background: #0d1014; border-bottom: 1px solid #232a33; color: #8b96a3; font: 500 0.8rem var(--ifm-font-family-monospace); }
+.theme-code-block pre, .theme-code-block code { background: #0d1014 !important; }
+
+/* Screenshots in the docs: a hairline instead of a floating shadow. */
+.markdown img { border-radius: 6px; box-shadow: 0 0 0 1px var(--ifm-color-emphasis-300); }
+
+/* Lesson widgets: the benchmark bars (Bench.tsx) and the picture row (Compare.tsx). */
+/* Lesson components: Compare, Bench, ApiLink */
+.stb-compare { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.25rem 0; }
+
+.stb-compare__item { margin: 0; max-width: 100%; }
+
+.stb-compare__item img {
+  display: block;
+  max-width: 100%;
+  height: auto;
+  border: 1px solid var(--stb-line);
+  border-radius: var(--ifm-global-radius);
+  background: var(--stb-surface);
+}
+
+.stb-compare__item figcaption { margin-top: .35rem; font-size: .85rem; color: var(--stb-muted); }
+
+.stb-bench { margin: 1.25rem 0; }
+
+.stb-bench__op { margin-bottom: 1.5rem; }
+
+.stb-bench__op h4 { margin-bottom: .5rem; }
+
+.stb-bench__rows { list-style: none; margin: 0; padding: 0; }
+
+.stb-bench__row {
+  display: grid;
+  grid-template-columns: minmax(8rem, 12rem) 1fr minmax(6rem, 9rem);
+  align-items: center;
+  gap: .75rem;
+  padding: .25rem 0;
+}
+
+.stb-bench__bar { height: .75rem; background: var(--track); border-radius: 2px; overflow: hidden; }
+
+.stb-bench__bar > span { display: block; height: 100%; background: var(--fg3); }
+
+.stb-bench__row--own .stb-bench__name { font-weight: 800; }
+
+.stb-bench__value { font-family: var(--font-mono); font-size: .85rem; text-align: right; }
+
+.stb-bench__note, .stb-bench__foot { font-size: .85rem; color: var(--stb-muted); }
+
+.stb-bench__row { grid-template-columns: 1fr auto; }
+
+.stb-bench__bar { grid-column: 1 / -1; }
