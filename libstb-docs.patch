+.hero {
+  width: 100%;
+  display: grid;
+  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
+  gap: clamp(2rem, 5vw, 4.5rem);
+  align-items: center;
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: clamp(2.5rem, 7vw, 5.5rem) 1.5rem clamp(2.5rem, 6vw, 4.5rem);
+}
+.heroText h1 {
+  margin: 0 0 1.1rem;
+  font-size: clamp(2.3rem, 4.6vw, 3.6rem);
+  font-weight: 800;
+  line-height: 1.04;
+  letter-spacing: -0.035em;
+  text-wrap: balance;
+}
+.heroText p {
+  max-width: 34rem;
+  margin: 0 0 1.75rem;
+  font-size: 1.15rem;
+  line-height: 1.55;
+  color: var(--ifm-font-color-secondary);
+}
+.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.25rem; }
+.primary, .secondary {
+  display: inline-flex; align-items: center; min-height: 48px; padding: 0 1.4rem;
+  border-radius: var(--ifm-global-radius); font-weight: 700; text-decoration: none !important;
+}
+.primary { background: var(--libstb-ink); color: var(--libstb-on-ink) !important; }
+.primary:hover { filter: brightness(1.12); }
+.secondary { border: 1px solid var(--ifm-color-emphasis-400); color: var(--ifm-font-color-base) !important; }
+.secondary:hover { border-color: var(--ifm-font-color-base); }
+.install {
+  display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0 0.4rem 0 0.9rem;
+  border: 0; border-radius: var(--ifm-global-radius); background: var(--ifm-color-emphasis-200);
+  color: var(--ifm-font-color-base); font: 500 0.95rem var(--ifm-font-family-monospace); cursor: pointer;
+}
+.prompt { color: var(--ifm-color-primary); }
+.copy { margin-left: 0.6rem; padding: 0.3rem 0.65rem; border-radius: 3px; background: var(--ifm-background-color); font-size: 0.78rem; color: var(--ifm-font-color-secondary); }
+.install:focus-visible, .tab:focus-visible { outline: 2px solid var(--ifm-color-primary); outline-offset: 2px; }
+
+.window {
+  overflow: hidden; border-radius: 8px; background: #0d1014; color: #d7dde4;
+  border: 1px solid #232a33; box-shadow: 0 1px 0 #232a33, 0 28px 60px -28px rgba(10, 108, 143, 0.55);
+}
+.bar { display: flex; align-items: center; justify-content: space-between; padding: 0 1rem 0 0.4rem; border-bottom: 1px solid #232a33; }
+.tabs { display: flex; }
+.tab {
+  min-height: 38px; padding: 0 0.9rem; border: 0; border-bottom: 2px solid transparent; background: transparent;
+  color: #8b96a3; font: 500 0.84rem var(--ifm-font-family-monospace); cursor: pointer;
+}
+.tab[aria-selected='true'] { color: #5cc3e8; border-bottom-color: #5cc3e8; }
+.file { font: 0.8rem var(--ifm-font-family-monospace); color: #6b7684; }
+.code { margin: 0; padding: 1.25rem 1.4rem; overflow-x: auto; background: transparent; font: 0.92rem/1.65 var(--ifm-font-family-monospace); }
+.reply { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1.4rem 1.1rem; border-top: 1px solid #232a33; background: #0a0d11; font: 0.88rem var(--ifm-font-family-monospace); }
+.replyIn { color: #6b7684; }
+.replyOut { color: #5cc3e8; font-weight: 600; }
+
+.facts {
+  width: 100%;
+  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 6vw, 5rem);
+  max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 3rem;
+}
+.fact { padding: 1.6rem 0 1.9rem; border-top: 1px solid var(--ifm-color-emphasis-300); }
+.fact h2 { margin: 0 0 0.5rem; font-size: 1.3rem; letter-spacing: -0.02em; }
+.fact p { max-width: 32rem; margin: 0 0 0.8rem; line-height: 1.6; color: var(--ifm-font-color-secondary); }
+.fact a { font-weight: 700; }
+
+.close {
+  width: 100%;
+  display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem;
+  max-width: 1200px; margin: 0 auto; padding: 1.6rem 1.5rem 3.5rem; border-top: 0;
+  background: linear-gradient(var(--ifm-color-emphasis-300), var(--ifm-color-emphasis-300)) no-repeat 1.5rem 0 / calc(100% - 3rem) 1px;
+  color: var(--ifm-font-color-secondary);
+}
+.close p { margin: 0; }
+
+@media (max-width: 960px) {
+  .hero { grid-template-columns: minmax(0, 1fr); }
+  .facts { grid-template-columns: minmax(0, 1fr); }
+}
diff --git a/docs/site/src/pages/index.tsx b/docs/site/src/pages/index.tsx
new file mode 100644
index 0000000..5c230c0
--- /dev/null
+++ b/docs/site/src/pages/index.tsx
@@ -0,0 +1,106 @@
+import React, {useState} from 'react';
+import Layout from '@theme/Layout';
+import Link from '@docusaurus/Link';
+import {Highlight, themes} from 'prism-react-renderer';
+import languages from '@site/languages.json';
+import snippets from '@site/src/generated/snippets.json';
+import {useLang} from '@site/src/components/LangContext';
+import styles from './index.module.css';
+
+type Entry = {code: string; path: string; url: string};
+const data = snippets as unknown as Record<string, {files: Record<string, Record<string, Entry>>}>;
+const theme = {...themes.vsDark, plain: {...themes.vsDark.plain, backgroundColor: 'transparent', color: '#d7dde4'}};
+
+function Install() {
+  const [done, setDone] = useState(false);
+  const copy = () => {
+    navigator.clipboard?.writeText('pip install libstb').then(() => {
+      setDone(true);
+      setTimeout(() => setDone(false), 1600);
+    });
+  };
+  return (
+    <button type="button" className={styles.install} onClick={copy} aria-label="Copy pip install libstb">
+      <span className={styles.prompt}>$</span> pip install libstb
+      <span className={styles.copy}>{done ? 'Copied' : 'Copy'}</span>
+    </button>
+  );
+}
+
+function CodeWindow() {
+  const {lang, setLang} = useLang();
+  const entry = data.resize?.files.main?.[lang] ?? data.resize?.files.main?.[languages[0].id];
+  const known = languages.find((l) => l.id === lang) ?? languages[0];
+  return (
+    <div className={styles.window}>
+      <div className={styles.bar}>
+        <div role="tablist" aria-label="Language" className={styles.tabs}>
+          {languages.map((l) => (
+            <button key={l.id} type="button" role="tab" aria-selected={lang === l.id} className={styles.tab} onClick={() => setLang(l.id)}>
+              {l.label}
+            </button>
+          ))}
+        </div>
+        <span className={styles.file}>{entry?.path.split('/').pop()}</span>
+      </div>
+      <Highlight theme={theme} code={(entry?.code ?? '').trimEnd().replace(/\n{3,}/g, '\n\n')} language={known.prism ?? 'python'}>
+        {({tokens, getLineProps, getTokenProps}) => (
+          <pre className={styles.code}>
+            {tokens.map((line, i) => (
+              <div key={i} {...getLineProps({line})}>
+                {line.map((token, k) => (
+                  <span key={k} {...getTokenProps({token})} />
+                ))}
+              </div>
+            ))}
+          </pre>
+        )}
+      </Highlight>
+      <div className={styles.reply}>
+        <span className={styles.replyIn}>$ ls out</span>
+        <span className={styles.replyOut}>tiny.png  nearest.png  linear.png  cubic.png  bspline.png  mitchell.png</span>
+      </div>
+    </div>
+  );
+}
+
+const facts = [
+  {title: 'No dependencies', text: 'No system libraries and no Python dependencies. The Linux x86-64 wheel is under 1 MB, and the C++ library builds from source with CMake.', to: '/docs/install', cta: 'Install'},
+  {title: 'Python and C++, one library', text: 'The same operations in libstb.Image and stb::image. Decode PNG, JPEG, BMP, TGA and GIF, edit, resize, draw and encode.', to: '/docs/image/resize', cta: 'Resize an image'},
+  {title: 'Text that shapes properly', text: 'TrueType and CFF fonts with GSUB shaping, bidi reordering and kerning, so Persian and Arabic come out right.', to: 'https://github.com/mohammadraziei/libstb/blob/master/docs/guide.md', cta: 'Read the guide'},
+  {title: 'Fast where it pays', text: 'SIMD kernels picked at run time with identical results, the GIL released in Python calls, and big resizes split over threads.', to: '/benchmarks', cta: 'See the numbers'},
+];
+
+export default function Home() {
+  return (
+    <Layout title="Images, fonts and zlib for Python and C++" description="Decode, encode, resize, edit and draw images, render text and compress with zlib, from Python and C++. No dependencies.">
+      <header className={styles.hero}>
+        <div className={styles.heroText}>
+          <h1>Bitmaps and typography, in one small library.</h1>
+          <p>libstb decodes, encodes, resizes, edits and draws images, renders text and compresses with zlib, from Python and C++. Nothing has to be installed on the system first.</p>
+          <div className={styles.actions}>
+            <Link className={styles.primary} to="/docs/install">Get started</Link>
+            <Link className={styles.secondary} to="/docs/">Read the docs</Link>
+          </div>
+          <Install />
+        </div>
+        <CodeWindow />
+      </header>
+
+      <main className={styles.facts}>
+        {facts.map((f) => (
+          <section key={f.title} className={styles.fact}>
+            <h2>{f.title}</h2>
+            <p>{f.text}</p>
+            <Link to={f.to}>{f.cta}</Link>
+          </section>
+        ))}
+      </main>
+
+      <footer className={styles.close}>
+        <p>MIT licensed, built in the open.</p>
+        <Link to="https://github.com/mohammadraziei/libstb">Star it or open an issue on GitHub</Link>
+      </footer>
+    </Layout>
+  );
+}
